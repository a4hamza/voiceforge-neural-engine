{
  "name": "VoiceForge Neural TTS Engine",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "pip install --no-cache-dir pocket-tts fastapi uvicorn scipy safetensors python-multipart",
  "postStartCommand": "nohup python app.py > /tmp/voiceforge.log 2>&1 &",
  "portsAttributes": {
    "7860": {
      "label": "VoiceForge API",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "forwardPorts": [7860]
}
